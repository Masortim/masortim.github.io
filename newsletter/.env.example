# Переменные серверной части (Vercel → Settings → Environment Variables).
# Значения НЕ коммитить: файл только показывает, что нужно задать.

# Supabase — хранилище подписчиков (таблица public.newsletter_subscribers).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Resend — отправка писем.
RESEND_API_KEY=re_<...>
NEWSLETTER_FROM=Masortim <digest@masortim.github.io>

# Адрес сайта: используется в ссылках писем и в CORS.
NEWSLETTER_SITE=https://masortim.github.io

# Секрет для /api/newsletter/digest (Vercel Cron присылает его в Authorization).
CRON_SECRET=<32 random bytes, hex>
